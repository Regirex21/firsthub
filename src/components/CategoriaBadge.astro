---
/* Pastilla de color que identifica el programa de la entrada */
import { CATEGORIAS, type Categoria } from "../lib/blog";

interface Props {
  categoria: Categoria;
  tamano?: "sm" | "md";
  enlace?: boolean;
}

const { categoria, tamano = "sm", enlace = false } = Astro.props;
const c = CATEGORIAS[categoria];

const estilo = `color:${c.color};border-color:${c.color}59;background-color:${c.color}1f;`;
const clases = [
  "inline-flex items-center gap-2 rounded-full border font-semibold uppercase tracking-widest transition duration-300",
  tamano === "sm" ? "text-[11px] px-3 py-1" : "text-xs px-4 py-1.5",
  enlace ? "hover:brightness-125" : "",
];
const Etiqueta = enlace ? "a" : "span";
---

<Etiqueta
  class:list={clases}
  style={estilo}
  href={enlace ? `/blog/categoria/${categoria}` : undefined}
>
  <span
    class="h-1.5 w-1.5 rounded-full"
    style={`background-color:${c.color}`}
    aria-hidden="true"
  ></span>
  {c.etiqueta}
</Etiqueta>
