---
import "../styles/global.css";
/* La analítica de Vercel la carga Consentimiento solo si la persona acepta */
import Consentimiento from "../components/Consentimiento.astro";

const {
  title = "FIRSTHub",
  description = "Democratizando el acceso a recursos de FTC y FRC para estudiantes, mentores y voluntarios.",
  /* "website" para páginas normales, "article" para entradas del blog */
  tipo = "website",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://firsthub.dev");

/* Marca el enlace del menú que corresponde a la página actual */
const ruta = Astro.url.pathname;
/* "Docs" abre un submenú con las dos documentaciones */
const DOCS = [
  { href: "/docs-ftc/", texto: "Documentación FTC", color: "#ff8c42" },
  { href: "/docs-frc/", texto: "Documentación FRC", color: "#48a9a6" },
];
const enlaces = [
  { href: "/", texto: "Inicio" },
  { href: "/blog", texto: "Blog" },
  { href: "/docs", texto: "Docs", submenu: DOCS },
  { href: "/voluntarios", texto: "Voluntarios" },
  { href: "/contacto", texto: "Contacto" },
];
const esActivo = (href: string) =>
  href === "/" ? ruta === "/" : ruta === href || ruta.startsWith(href + "/");
---

<html lang="es" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>

  <!-- TIPOGRAFÍA
       Las dos fuentes del sitio se auto-hospedan (ver global.css).
       Se precargan solo los subconjuntos latinos, que son los que
       usa todo el contenido en español: el navegador los pide de
       inmediato en vez de esperar a descargar el CSS. -->
  <link
    rel="preload"
    href="/fonts/inter-latin-wght-normal.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link
    rel="preload"
    href="/fonts/space-grotesk-latin-wght-normal.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />

  <!-- SEO / REDES SOCIALES -->
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:site_name" content="FIRSTHub" />
  <meta property="og:type" content={tipo} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- DATOS ESTRUCTURADOS PARA GOOGLE (solo en Inicio)
       Le dicen a Google qué es FIRSTHub, cuál es su logo y cuáles son
       sus perfiles oficiales; es lo que usa para armar la ficha del
       sitio en los resultados. -->
  {ruta === "/" && (
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "FIRSTHub",
        url: "https://www.firsthub.dev/",
        logo: "https://www.firsthub.dev/images/firsthub_logo.svg",
        description: "Documentación, noticias y tutoriales de FIRST Robotics Competition y FIRST Tech Challenge en español.",
        email: "firsthubofficial@gmail.com",
        sameAs: ["https://www.instagram.com/_firsthub/"],
      },
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "FIRSTHub",
        url: "https://www.firsthub.dev/",
        inLanguage: "es",
      },
    ])} />
  )}

  <!-- Etiquetas extra por página (por ejemplo, noindex en el 404) -->
  <slot name="head" />

  <!-- RSS DEL BLOG -->
  <link
    rel="alternate"
    type="application/rss+xml"
    title="Blog de FIRSTHub"
    href="/blog/rss.xml"
  />
</head>

<body class="bg-[#2a2d43] text-white min-h-screen flex flex-col">

  <!-- ================================================= -->
  <!-- HEADER / NAVBAR                                   -->
  <!-- ================================================= -->
  <header class="border-b border-white/10">

    <nav class="max-w-6xl mx-auto px-6 py-4">

      <!-- FILA PRINCIPAL -->
      <div class="flex items-center justify-between">

        <!-- LOGO -->
        <a
          href="/"
          class="flex items-center gap-3 text-2xl font-bold text-[#fbfff1] hover:opacity-90 transition"
        >
          <img
            src="/images/firsthub_logo.svg"
            alt="FIRSTHub Logo"
            class="h-12 w-auto"
          />
        </a>

        <!-- MENÚ DESKTOP -->
        <div class="hidden md:flex items-center gap-6 text-sm font-medium">
          {enlaces.map((enlace) =>
            enlace.submenu ? (
              /* Submenú: se abre al pasar el mouse o al enfocarlo con el teclado */
              <div class="group relative">
                <a
                  href={enlace.href}
                  aria-haspopup="true"
                  aria-current={esActivo(enlace.href) ? "page" : undefined}
                  class:list={[
                    "inline-flex items-center gap-1 transition hover:text-[#ff8c42]",
                    esActivo(enlace.href) ? "text-[#ff8c42]" : "",
                  ]}
                >
                  {enlace.texto}
                  <svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10" class="mt-px transition group-hover:rotate-180 group-focus-within:rotate-180"><path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
                <div class="invisible absolute left-1/2 top-full z-50 -translate-x-1/2 pt-3 opacity-0 transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                  <div class="w-56 rounded-xl border border-white/10 bg-[#313553] p-2 shadow-xl shadow-black/30">
                    {enlace.submenu.map((s) => (
                      <a href={s.href} class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-[#fbfff1] transition hover:bg-white/[0.06]">
                        <span class="h-2.5 w-2.5 rounded-full" style={`background:${s.color}`}></span>
                        {s.texto}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={enlace.href}
                aria-current={esActivo(enlace.href) ? "page" : undefined}
                class:list={[
                  "transition hover:text-[#ff8c42]",
                  esActivo(enlace.href) ? "text-[#ff8c42]" : "",
                ]}
              >
                {enlace.texto}
              </a>
            )
          )}
        </div>

        <!-- BOTÓN HAMBURGUESA -->
        <button
          id="menu-btn"
          class="md:hidden text-3xl text-[#fbfff1]"
          aria-label="Abrir menú"
        >
          ☰
        </button>

      </div>

      <!-- MENÚ MOBILE -->
      <div
        id="mobile-menu"
        class="hidden md:hidden mt-4 flex flex-col gap-3 text-sm font-medium"
      >
        {enlaces.flatMap((enlace) =>
          /* En celular el submenú se muestra como dos opciones */
          enlace.submenu ? enlace.submenu.map((s) => ({ href: s.href, texto: s.texto })) : [enlace]
        ).map((enlace, i, todos) => (
          <a
            href={enlace.href}
            aria-current={esActivo(enlace.href) ? "page" : undefined}
            class:list={[
              "py-2",
              i < todos.length - 1 ? "border-b border-white/10" : "",
              esActivo(enlace.href) ? "text-[#ff8c42]" : "",
            ]}
          >
            {enlace.texto}
          </a>
        ))}
      </div>

    </nav>

  </header>

  <!-- CONTENIDO -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- FOOTER -->
  <footer class="border-t border-white/10 mt-20">
    <div
      class="max-w-6xl mx-auto px-6 py-8 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-white/50"
    >
      <span>©2026.      &lt;/ Aprende • Construye • Compite /&gt;</span>

      <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        <a href="/privacidad" class="hover:text-[#ff8c42] transition">
          Privacidad
        </a>
        <a href="/terminos" class="hover:text-[#ff8c42] transition">
          Aviso legal
        </a>
        <a href="/licencia" class="hover:text-[#ff8c42] transition">
          Licencia
        </a>
        <a href="/blog/rss.xml" class="hover:text-[#ff8c42] transition">
          RSS del blog
        </a>
        <button type="button" data-fh-preferencias class="hover:text-[#ff8c42] transition">
          Preferencias de privacidad
        </button>
      </nav>
    </div>

    <!-- Deslinde: aparece en todas las páginas del sitio -->
    <div
      class="max-w-6xl mx-auto px-6 pb-8 text-xs leading-relaxed text-white/30"
    >
      FIRSTHub es un proyecto comunitario independiente. No está afiliado,
      patrocinado ni respaldado por <em>FIRST</em>. Las traducciones no
      sustituyen a la documentación oficial: ante cualquier diferencia, manda el
      documento original.

      <span class="block mt-2">
        Todos los derechos de propiedad intelectual e industrial reservados,
        salvo el contenido publicado expresamente bajo
        <a href="/licencia" class="underline underline-offset-2 hover:text-[#ff8c42] transition">licencia abierta</a>.
        Las imágenes, textos y elementos visuales son propiedad exclusiva de sus
        creadores.
      </span>
    </div>
  </footer>

  <Consentimiento />

  <!-- SCRIPT MENU -->
  <script>
    const btn = document.getElementById("menu-btn");
    const menu = document.getElementById("mobile-menu");

    if (btn && menu) {
      btn.addEventListener("click", () => {
        menu.classList.toggle("hidden");
      });
    }
  </script>

</body>
</html>
