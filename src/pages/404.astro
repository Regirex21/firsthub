---
/* ================================================= */
/* PÁGINA DE ERROR 404                               */
/*                                                   */
/* Vercel la sirve para cualquier dirección que no   */
/* exista en el sitio principal. Además de los       */
/* caminos de siempre, propone las páginas cuyo      */
/* nombre más se parece a la dirección que falló     */
/* (se calcula en el navegador con la lista de       */
/* abajo) y permite avisar del enlace roto.          */
/* ================================================= */
import MainLayout from "../layouts/MainLayout.astro";
import { getPosts } from "../lib/blog";
import { CORREO_CONTACTO } from "../lib/legal";

/* Páginas que se pueden sugerir: las del sitio, las portadas de la
   documentación y todas las entradas del blog. */
const posts = await getPosts();
const PAGINAS = [
  { url: "/", titulo: "Inicio" },
  { url: "/blog", titulo: "Blog" },
  { url: "/docs", titulo: "Documentación" },
  { url: "/docs-ftc/", titulo: "Documentación de FTC" },
  { url: "/docs-frc/", titulo: "Documentación de FRC" },
  { url: "/voluntarios", titulo: "Voluntarios" },
  { url: "/contacto", titulo: "Contacto" },
  { url: "/privacidad", titulo: "Aviso de privacidad" },
  { url: "/terminos", titulo: "Aviso legal y términos de uso" },
  { url: "/licencia", titulo: "Licencia" },
  ...posts.map((p) => ({ url: `/blog/${p.id}`, titulo: p.data.titulo })),
];

const CAMINOS = [
  { href: "/docs-ftc/", texto: "Documentación de FTC", detalle: "Control Hub, programación, premios y portafolio", color: "#ff8c42" },
  { href: "/docs-frc/", texto: "Documentación de FRC", detalle: "WPILib, roboRIO, radio y premios", color: "#48a9a6" },
  { href: "/blog", texto: "Blog", detalle: "Noticias de la temporada y traducciones", color: "#ffcd00" },
];
---

<MainLayout
  title="Página no encontrada | FIRSTHub"
  description="Esta dirección no existe en FIRSTHub."
>
  <meta name="robots" content="noindex" slot="head" />

  <section class="max-w-4xl mx-auto px-6 pt-16 md:pt-24 pb-10">
    <p class="font-display text-[17px] font-medium text-[#ff8c42]">Error 404</p>
    <h1 class="mt-[18px] mb-0 text-[44px] md:text-[60px] font-bold leading-none tracking-[-0.035em] text-[#fbfff1]">
      Esta página no existe.
    </h1>
    <p class="mt-6 max-w-[36em] text-[17px] leading-relaxed text-[#bfc0c6]">
      La dirección
      <code id="ruta-404" class="rounded-md bg-[#313553] px-2 py-0.5 text-[15px] text-[#fbfff1] break-all"></code>
      no lleva a ninguna página. Puede que la hayamos movido, que el enlace
      tenga un error de dedo o que la página todavía no exista.
    </p>
  </section>

  <!-- Sugerencias: se llenan en el navegador; si no hay ninguna parecida, la sección no aparece -->
  <section id="sugerencias-404" hidden class="max-w-4xl mx-auto px-6 pb-10">
    <h2 class="mb-0 text-xl font-bold text-[#fbfff1]">¿Buscabas alguna de estas?</h2>
    <ul id="lista-404" class="mt-4 border-t border-white/10"></ul>
  </section>

  <section class="max-w-4xl mx-auto px-6 pb-10">
    <h2 class="mb-0 text-xl font-bold text-[#fbfff1]">O empieza por aquí</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      {CAMINOS.map((c) => (
        <a
          href={c.href}
          class="group block fh-relieve rounded-2xl border-t-4 bg-[#313553]/55 p-5 transition duration-300 hover:-translate-y-1"
          style={`border-top-color:${c.color}`}
        >
          <span class="block font-display text-lg font-bold text-[#fbfff1] transition group-hover:text-[var(--c)]" style={`--c:${c.color}`}>{c.texto}</span>
          <span class="mt-1.5 block text-sm leading-relaxed text-[#bfc0c6]">{c.detalle}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 pb-4">
    <p class="text-[15px] leading-relaxed text-[#bfc0c6]">
      ¿Llegaste aquí desde un enlace de FIRSTHub?
      <a
        id="reportar-404"
        href={`mailto:${CORREO_CONTACTO}?subject=Enlace%20roto%20en%20FIRSTHub`}
        class="font-semibold text-[#fbfff1] underline underline-offset-[3px] transition hover:text-[#ff8c42]"
      >Avísanos del enlace roto</a>
      y lo arreglamos. O vuelve al <a href="/" class="font-semibold text-[#fbfff1] underline underline-offset-[3px] transition hover:text-[#ff8c42]">inicio</a>.
    </p>
  </section>

  <script define:vars={{ PAGINAS }}>
    const ruta = decodeURIComponent(location.pathname);
    document.getElementById("ruta-404").textContent = ruta;

    // Enlace de reporte con la dirección que falló y de dónde venía la persona
    const reportar = document.getElementById("reportar-404");
    const cuerpo = `La dirección ${location.href} no existe.` + (document.referrer ? `\nLlegué desde: ${document.referrer}` : "");
    reportar.href += "&body=" + encodeURIComponent(cuerpo);

    // Palabras de la dirección que falló (sin acentos, sin palabras vacías)
    const normalizar = (t) => t.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
    const VACIAS = new Set(["de", "la", "el", "en", "y", "los", "las", "del", "para", "por", "con", "un", "una", "docs", "blog", "html", "index"]);
    const palabras = (t) => normalizar(t).split(/[^a-z0-9]+/).filter((p) => p.length > 1 && !VACIAS.has(p));

    const buscadas = palabras(ruta);
    if (buscadas.length) {
      const puntuar = (pag) => {
        const suyas = new Set([...palabras(pag.url), ...palabras(pag.titulo)]);
        let puntos = 0;
        for (const b of buscadas) {
          if (suyas.has(b)) puntos += 2;
          else if ([...suyas].some((s) => s.length > 3 && (s.startsWith(b) || b.startsWith(s)))) puntos += 1;
        }
        return puntos / buscadas.length;
      };
      const mejores = PAGINAS
        .map((p) => ({ ...p, puntos: puntuar(p) }))
        .filter((p) => p.puntos >= 0.5)
        .sort((a, b) => b.puntos - a.puntos)
        .slice(0, 4);

      if (mejores.length) {
        const lista = document.getElementById("lista-404");
        for (const p of mejores) {
          const li = document.createElement("li");
          li.className = "border-b border-white/10";
          const a = document.createElement("a");
          a.href = p.url;
          a.className = "flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3.5 text-[#fbfff1] transition hover:text-[#ff8c42]";
          a.innerHTML = '<span class="font-semibold"></span><span class="text-sm text-[#9a9caa]"></span>';
          a.children[0].textContent = p.titulo;
          a.children[1].textContent = p.url;
          li.appendChild(a);
          lista.appendChild(li);
        }
        document.getElementById("sugerencias-404").hidden = false;
      }
    }
  </script>
</MainLayout>
