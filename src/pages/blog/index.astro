---
/* ================================================= */
/* ÍNDICE DEL BLOG                                   */
/* Entrada destacada + filtros por programa y        */
/* etiqueta + grid de todas las entradas             */
/* ================================================= */
import MainLayout from "../../layouts/MainLayout.astro";
import PostCard from "../../components/PostCard.astro";
import {
  getPosts,
  tagsDe,
  formatoFecha,
  tiempoLectura,
  CATEGORIAS,
  CATEGORIAS_LISTA,
} from "../../lib/blog";

const posts = await getPosts();

/* La entrada marcada como destacada encabeza la página;
   si no hay ninguna, se usa la más reciente */
const destacado = posts.find((p) => p.data.destacado) ?? posts[0];

/* La destacada no se repite en el grid: se filtra desde su propia sección,
   junto con las demás. Así los contadores de los filtros y lo que se ve en
   pantalla siempre cuadran, incluso cuando solo hay una entrada. */
const resto = posts.filter((p) => p.id !== destacado?.id);

const tags = tagsDe(posts);
/* Cuántos temas se ven antes de "Ver los N temas" (los más usados primero) */
const TAGS_VISIBLES = 9;
const conteo = Object.fromEntries(
  CATEGORIAS_LISTA.map((c) => [c, posts.filter((p) => p.data.categoria === c).length])
);
---

<MainLayout
  title="Blog | FIRSTHub"
  description="Noticias, newsletters traducidos al español e insights sobre FTC, FRC y el ecosistema FIRST."
>

  <!-- ================================================= -->
  <!-- HERO                                              -->
  <!-- ================================================= -->
  <section class="max-w-6xl mx-auto px-6 pt-16 md:pt-20 pb-12">

    <p class="font-display text-[17px] font-medium text-[#ff8c42]">
      Noticias • Traducciones • Insights
    </p>

    <h1 class="mt-[18px] mb-0 text-[44px] md:text-[60px] font-bold leading-none tracking-[-0.035em] text-[#fbfff1]">
      Blog
    </h1>

    <p class="mt-[22px] max-w-[34em] text-[17px] leading-relaxed text-[#bfc0c6]">
      Newsletters de FIRST traducidos al español, análisis de reglas,
      anuncios de temporada y aprendizajes de la comunidad. Todo en un solo lugar.
    </p>

  </section>


  {posts.length === 0 ? (

    <!-- ESTADO VACÍO -->
    <section class="max-w-3xl mx-auto px-6 pb-24 text-center">
      <div class="rounded-2xl border border-dashed border-white/15 bg-[#313553] p-12">
        <h2 class="text-2xl font-semibold text-[#fbfff1]">
          Todavía no hay entradas publicadas
        </h2>
        <p class="mt-4 text-white/70 leading-relaxed">
          Agrega un archivo <code class="text-[#ff8c42]">.md</code> en
          <code class="text-[#ff8c42]">src/content/blog/</code> y aparecerá aquí
          en el siguiente despliegue.
        </p>
      </div>
    </section>

  ) : (

    <>

      <!-- ================================================= -->
      <!-- ENTRADA DESTACADA                                 -->
      <!-- ================================================= -->
      <section
        id="seccion-destacada"
        class="max-w-6xl mx-auto px-6 pb-12"
        data-categoria={destacado.data.categoria}
        data-tags={destacado.data.tags.join("|")}
      >

        <a
          href={`/blog/${destacado.id}`}
          class="group block rounded-[22px] border border-white/[0.08] bg-[#313553] p-8 md:px-12 md:pt-12 md:pb-11 transition duration-200 hover:border-[#ff8c42]/55"
        >

          <div class="flex flex-wrap items-center gap-x-3.5 gap-y-2.5 text-sm">
            <span
              class="rounded-full px-3 py-1 font-semibold text-[#2a2d43]"
              style={`background-color:${CATEGORIAS[destacado.data.categoria].color}`}
            >
              {CATEGORIAS[destacado.data.categoria].etiqueta}
            </span>
            <span class="font-semibold text-[#ff8c42]">Destacada</span>
          </div>

          <h2 class="mt-5 mb-0 max-w-[22em] text-[26px] md:text-[34px] font-bold leading-[1.12] tracking-[-0.025em] text-[#fbfff1] transition duration-200 group-hover:text-[#ff8c42]">
            {destacado.data.titulo}
          </h2>

          <p class="mt-4 max-w-[40em] text-base leading-relaxed text-[#bfc0c6]">
            {destacado.data.resumen}
          </p>

          <p class="mt-[26px] flex flex-wrap gap-x-6 gap-y-1.5 text-sm text-[#bfc0c6]">
            <span class="font-semibold text-[#fbfff1]">{destacado.data.autor.nombre}</span>
            <span>{formatoFecha(destacado.data.fecha)}</span>
            <span>{tiempoLectura(destacado.body)} min de lectura</span>
          </p>

        </a>

      </section>


      <!-- ================================================= -->
      <!-- FILTROS                                           -->
      <!-- ================================================= -->
      <section class="max-w-6xl mx-auto px-6 pt-4 pb-10">

        <!-- POR PROGRAMA -->
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3.5 pb-[22px]">
          <span class="min-w-[72px] text-sm font-semibold text-[#bfc0c6]">Programa</span>

          <div class="flex flex-wrap gap-2.5" id="filtros-categoria">
            <button
              type="button"
              data-filtro="todas"
              aria-pressed="true"
              class="filtro-cat rounded-full border border-[#ff8c42] bg-[#ff8c42] px-[18px] py-[9px] text-[15px] font-semibold text-[#2a2d43] transition duration-200"
            >
              Todas
              <span class="ml-1 opacity-70">{posts.length}</span>
            </button>

            {CATEGORIAS_LISTA.map((cat) => (
              <button
                type="button"
                data-filtro={cat}
                aria-pressed="false"
                class="filtro-cat rounded-full border border-white/[0.22] px-[18px] py-[9px] text-[15px] font-semibold text-[#e6e8dc] transition duration-200 hover:border-[#ff8c42]"
              >
                {CATEGORIAS[cat].etiqueta}
                <span class="ml-1 opacity-60">{conteo[cat]}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- POR ETIQUETA: se ven las más usadas y el resto se despliega -->
        {tags.length > 0 && (
          <div class="flex flex-wrap items-start gap-x-6 gap-y-3.5 border-t border-white/[0.08] pt-[22px]">
            <span class="min-w-[72px] pt-[7px] text-sm font-semibold text-[#bfc0c6]">Temas</span>

            <div class="flex min-w-0 flex-1 flex-wrap gap-2" id="filtros-tag">
              {tags.map((tag, i) => (
                <button
                  type="button"
                  data-tag={tag}
                  aria-pressed="false"
                  class:list={[
                    "filtro-tag rounded-full border border-white/[0.16] px-[13px] py-1.5 text-sm text-[#bfc0c6] transition duration-200 hover:border-[#ff8c42]",
                    i >= TAGS_VISIBLES && "tag-extra hidden",
                  ]}
                >
                  #{tag}
                </button>
              ))}
              {tags.length > TAGS_VISIBLES && (
                <button
                  type="button"
                  id="ver-temas"
                  aria-expanded="false"
                  class="px-1 py-1.5 text-sm font-semibold text-[#ff8c42] transition hover:text-[#fbfff1]"
                >
                  Ver los {tags.length} temas
                </button>
              )}
            </div>
          </div>
        )}

      </section>


      <!-- ================================================= -->
      <!-- GRID DE ENTRADAS                                  -->
      <!-- ================================================= -->
      <section
        id="grid-posts"
        class="max-w-6xl mx-auto px-6 pb-6 grid md:grid-cols-2 gap-7"
      >
        {resto.map((post) => <PostCard post={post} />)}
      </section>

      <!-- SIN RESULTADOS AL FILTRAR -->
      <p
        id="sin-resultados"
        class="hidden max-w-6xl mx-auto px-6 pb-8 text-center text-white/50"
      >
        No hay entradas con esa combinación de filtros.
      </p>


      <!-- ================================================= -->
      <!-- BOLETÍN POR CORREO                                -->
      <!-- El formulario publica directo en Brevo. Doble     -->
      <!-- confirmación: al enviar, Brevo manda un correo    -->
      <!-- con un enlace y el contacto entra a la lista      -->
      <!-- "Boletín FIRSTHub" solo hasta que le da clic.     -->
      <!-- El campo email_address_check es una trampa para   -->
      <!-- bots: va oculto y tiene que llegar vacío.         -->
      <!-- ================================================= -->
      <section id="boletin" aria-labelledby="boletin-titulo" class="mt-20 bg-[#252839] scroll-mt-8">

        <div class="max-w-6xl mx-auto px-6 pt-20 pb-[88px] flex flex-wrap items-start gap-x-20 gap-y-10">

          <div class="min-w-0 flex-[1_1_420px]">
            <p class="text-[15px] font-semibold text-[#48a9a6]">
              Boletín semanal
            </p>

            <h2 id="boletin-titulo" class="mt-2.5 text-3xl md:text-[40px] font-bold leading-[1.1] tracking-[-0.03em] text-[#fbfff1]">
              No te pierdas ninguna noticia.
            </h2>

            <p class="mt-4 max-w-[32em] text-[17px] leading-relaxed text-[#bfc0c6]">
              Cada semana: noticias de FTC y FRC traducidas al español, cambios de
              reglas y lo que va aprendiendo la comunidad. Un correo, sin relleno.
            </p>
          </div>

          <div class="min-w-0 flex-[1_1_400px]">
          <form
            action="https://a5c737a2.sibforms.com/serve/MUIFALc7ZX8v_6tv_P0RLIPdWaUL5FMg6ZweTP-PBK9Bg2Psyv-taXoNx8uzu1DpYgCcbTTL3cVj-d9fIRPJudK6xm9HGEkXpWLbp_j_o2552JArJrJkN0r9lfr6VhVETI-ECyZsrZ1YWxBXR5MVY1v-1nhagIvmvwfJj0Z8YqOPodk3TYnIjo6GSLjZi4xo8ZwaRrXqLez90Xycow=="
            method="POST"
            class="flex flex-wrap gap-2.5"
          >

            <label for="boletin-email" class="w-full text-sm font-semibold text-[#fbfff1]">
              Tu correo electrónico
            </label>

            <input
              id="boletin-email"
              type="email"
              name="EMAIL"
              required
              autocomplete="email"
              placeholder="tu@correo.com"
              class="min-w-0 flex-[1_1_240px] rounded-xl border border-white/25 bg-[#2a2d43] px-4 py-3 text-[#fbfff1] placeholder-white/30 transition duration-300 focus:border-[#ff8c42] focus:outline-none"
            />

            <!-- Trampa para bots: invisible para las personas -->
            <input
              type="text"
              name="email_address_check"
              value=""
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
              class="hidden"
            />

            <input type="hidden" name="locale" value="es" />
            <input type="hidden" name="html_type" value="simple" />

            <button
              type="submit"
              class="rounded-xl border-2 border-[#ff8c42] bg-[#ff8c42] px-[22px] py-3 font-semibold text-[#2a2d43] transition duration-200 hover:bg-transparent hover:text-[#ff8c42]"
            >
              Suscribirme
            </button>

          </form>

          <p class="mt-4 text-[13px] leading-relaxed text-[#9a9caa]">
            Te llegará un correo para confirmar. Puedes darte de baja cuando
            quieras. Solo guardamos tu correo, y solo para esto:
            <a
              href="/privacidad"
              class="text-[#bfc0c6] underline underline-offset-[3px] transition hover:text-[#ff8c42]"
            >
              aviso de privacidad
            </a>.
          </p>

          <p class="mt-2 text-sm text-[#bfc0c6]">
            ¿Prefieres el chat?
            <a
              href="https://chat.whatsapp.com/LmUwj6dra1pDLwkQvoD6vY"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-[#fbfff1] underline underline-offset-[3px] transition hover:text-[#ff8c42]"
            >
              Únete a la comunidad de WhatsApp
            </a>
          </p>
          </div>

        </div>

      </section>

    </>

  )}

  <!-- ================================================= -->
  <!-- FILTRADO EN EL NAVEGADOR                          -->
  <!-- Sin recargar la página: se muestran u ocultan     -->
  <!-- las tarjetas según programa y etiqueta            -->
  <!-- ================================================= -->
  <script>
    const grid = document.getElementById("grid-posts");

    if (grid) {
      /* La entrada destacada vive fuera del grid pero sí cuenta para los
         filtros, así que se filtra junto con las tarjetas */
      const destacada = document.getElementById("seccion-destacada");
      const tarjetas = [
        ...(destacada ? [destacada] : []),
        ...Array.from(grid.children),
      ] as HTMLElement[];
      const botonesCat = Array.from(
        document.querySelectorAll<HTMLButtonElement>(".filtro-cat")
      );
      const botonesTag = Array.from(
        document.querySelectorAll<HTMLButtonElement>(".filtro-tag")
      );
      const vacio = document.getElementById("sin-resultados");

      let categoria = "todas";
      let tag: string | null = null;

      const ACTIVO_CAT = ["border-[#ff8c42]", "bg-[#ff8c42]", "text-[#2a2d43]"];
      const INACTIVO_CAT = ["border-white/[0.22]", "bg-transparent", "text-[#e6e8dc]", "hover:border-[#ff8c42]"];
      const ACTIVO_TAG = ["border-[#ff8c42]", "bg-[#ff8c42]/15", "text-[#fbfff1]"];
      const INACTIVO_TAG = ["border-white/[0.16]", "text-[#bfc0c6]", "hover:border-[#ff8c42]"];

      /* "Ver los N temas" despliega los temas menos usados */
      const verTemas = document.getElementById("ver-temas");
      verTemas?.addEventListener("click", () => {
        document.querySelectorAll(".tag-extra").forEach((el) => el.classList.remove("hidden"));
        verTemas.remove();
      });

      function pintar() {
        for (const boton of botonesCat) {
          const activo = boton.dataset.filtro === categoria;
          boton.setAttribute("aria-pressed", String(activo));
          boton.classList.remove(...ACTIVO_CAT, ...INACTIVO_CAT);
          boton.classList.add(...(activo ? ACTIVO_CAT : INACTIVO_CAT));
        }

        for (const boton of botonesTag) {
          const activo = boton.dataset.tag === tag;
          boton.setAttribute("aria-pressed", String(activo));
          boton.classList.remove(...ACTIVO_TAG, ...INACTIVO_TAG);
          boton.classList.add(...(activo ? ACTIVO_TAG : INACTIVO_TAG));
        }

        let visibles = 0;
        for (const tarjeta of tarjetas) {
          const suCategoria = tarjeta.dataset.categoria ?? "";
          const susTags = (tarjeta.dataset.tags ?? "").split("|").filter(Boolean);
          const pasaCategoria = categoria === "todas" || suCategoria === categoria;
          const pasaTag = tag === null || susTags.includes(tag);
          const visible = pasaCategoria && pasaTag;
          tarjeta.classList.toggle("hidden", !visible);
          if (visible) visibles++;
        }

        vacio?.classList.toggle("hidden", visibles > 0);
      }

      for (const boton of botonesCat) {
        boton.addEventListener("click", () => {
          categoria = boton.dataset.filtro ?? "todas";
          pintar();
        });
      }

      for (const boton of botonesTag) {
        boton.addEventListener("click", () => {
          tag = boton.dataset.tag === tag ? null : (boton.dataset.tag ?? null);
          pintar();
        });
      }

      pintar();
    }
  </script>

</MainLayout>
